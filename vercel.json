{
  "version": 2,
  "public": true,
  "name": "airsense-team",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/hardware",
      "dest": "/public/hardware.html"
    },
    {
      "src": "/opensource",
      "dest": "/public/opensource.html"
    },
    {
      "src": "/command",
      "dest": "/public/command.html"
    },
    {
      "src": "/ops",
      "dest": "/public/command.html"
    },
    {
      "src": "/enterprise",
      "dest": "/public/enterprise.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
