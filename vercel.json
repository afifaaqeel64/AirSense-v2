{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/hardware",
      "destination": "/public/hardware.html"
    },
    {
      "source": "/opensource",
      "destination": "/public/opensource.html"
    },
    {
      "source": "/command",
      "destination": "/public/command.html"
    },
    {
      "source": "/ops",
      "destination": "/public/command.html"
    },
    {
      "source": "/enterprise",
      "destination": "/public/enterprise.html"
    },
    {
      "source": "/diagnostics",
      "destination": "/public/diagnostics.html"
    },
    {
      "source": "/sensor-health",
      "destination": "/public/diagnostics.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}
