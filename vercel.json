{
  "version": 2,
  "public": true,
  "name": "airsense-team",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/api"
    },
    {
      "source": "/openapi.json",
      "destination": "/api"
    },
    {
      "source": "/hardware",
      "destination": "/public/hardware.html"
    },
    {
      "source": "/opensource",
      "destination": "/public/opensource.html"
    },
    {
      "source": "/command",
      "destination": "/public/command.html"
    },
    {
      "source": "/ops",
      "destination": "/public/command.html"
    },
    {
      "source": "/enterprise",
      "destination": "/public/enterprise.html"
    },
    {
      "source": "/diagnostics",
      "destination": "/public/diagnostics.html"
    },
    {
      "source": "/sensor-health",
      "destination": "/public/diagnostics.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
