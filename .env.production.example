# ==============================================================================
# AirSense Pakistan - Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on your production host (e.g. cp .env.production.example .env)
# 2. Replace all PLACEHOLDER values with strong cryptographic secrets.
# 3. Ensure this file is never committed to public git repositories.
# ==============================================================================

AIR_SENSE_ENV=production
AIR_SENSE_TIMEZONE=Asia/Karachi
DEBUG=False

# Database (Mode B: PostgreSQL / TimescaleDB recommended for 24/7 Production)
# Option 1: Supabase Managed Cloud PostgreSQL (Direct IPv6 or Session Pooler IPv4)
# Direct: postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Pooler: postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://airsense:CHANGE_TO_STRONG_DB_PASSWORD@airsense-db:5432/airsense
DB_PASSWORD=CHANGE_TO_STRONG_DB_PASSWORD

# Security Tokens & Cryptographic Salt (MUST be minimum 32 random characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=GENERATE_SECURE_ADMIN_TOKEN_64_CHARS
DEVICE_TOKEN_SALT=GENERATE_SECURE_SALT_FOR_DEVICE_TOKENS

# CORS Allowed Origins (Comma-separated list of allowed HTTPS domains)
CORS_ORIGINS=https://airsense-team.vercel.app,https://airsense.pk,https://api.airsense.pk

# Public Domain / Base URLs
BACKEND_BASE_URL=https://api.airsense.pk
FRONTEND_BASE_URL=https://airsense-team.vercel.app

# 24/7 Autonomous Background Workers & Security Controls
BACKGROUND_SCHEDULER_ENABLED=True
SECURITY_HEADERS_ENABLED=True
RATE_LIMIT_ENABLED=True
COPILOT_RATE_LIMIT_RPM=30
INGEST_RATE_LIMIT_RPM=120
BACKUP_RETENTION_COUNT=14

# Campus Locations & Contacts
KARACHI_CAMPUS_NAME=Karachi Campus
KARACHI_CAMPUS_CODE=KHI_CAMPUS
KARACHI_LATITUDE=24.8607
KARACHI_LONGITUDE=67.0011
KARACHI_CONTACT_NAME=Areesha

ISLAMABAD_CAMPUS_NAME=Islamabad Campus
ISLAMABAD_CAMPUS_CODE=ISB_CAMPUS
ISLAMABAD_LATITUDE=33.6844
ISLAMABAD_LONGITUDE=73.0479
ISLAMABAD_CONTACT_NAME=Muhammad M. Qureshi

# Optional Third-Party Weather & Satellite Integration API Keys
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
WAQI_API_TOKEN=
IQAIR_API_KEY=
NASA_FIRMS_MAP_KEY=
