# AirSense Pakistan - Development Environment Configuration
AIR_SENSE_ENV=development
AIR_SENSE_TIMEZONE=Asia/Karachi
DEBUG=True

# Database (Mode A: Local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/airsense.db

# Host & URLs
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Security Tokens (Replace in production)
ADMIN_API_TOKEN=dev_admin_secret_token_change_me
DEVICE_TOKEN_SALT=dev_device_salt_change_me

# Campus Coordinates
KARACHI_CAMPUS_NAME=Karachi Campus
KARACHI_CAMPUS_CODE=KHI_CAMPUS
KARACHI_LATITUDE=24.8607
KARACHI_LONGITUDE=67.0011
KARACHI_CONTACT_NAME=Areesha

ISLAMABAD_CAMPUS_NAME=Islamabad Campus
ISLAMABAD_CAMPUS_CODE=ISB_CAMPUS
ISLAMABAD_LATITUDE=33.6844
ISLAMABAD_LONGITUDE=73.0479
ISLAMABAD_CONTACT_NAME=Muhammad M. Qureshi

# Production & Background Worker Flags
BACKGROUND_SCHEDULER_ENABLED=True
SECURITY_HEADERS_ENABLED=True
RATE_LIMIT_ENABLED=True
BACKUP_RETENTION_COUNT=14
